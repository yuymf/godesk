{
  "name": "godesk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "pnpm build && wrangler dev --local --ip 127.0.0.1 --port 8799",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "verify:local-routes": "node scripts/verify-local-routes.mjs",
    "verify:local-loop": "pnpm build && node scripts/verify-local-loop.mjs",
    "verify:local-mcp": "pnpm build && node scripts/verify-local-mcp-loop.mjs",
    "verify:plugin": "node scripts/verify-plugin-bundle.mjs && node scripts/verify-plugin-distribution.mjs",
    "verify:plugin:public": "node scripts/verify-plugin-distribution.mjs --remote",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.1",
    "jose": "^6.2.4",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "packageManager": "pnpm@10.15.1"
}
