{
  "name": "godesk",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:worker": "pnpm build && wrangler dev --local --ip 127.0.0.1 --port 8799",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:worker": "test -f .dev.vars || cp .dev.vars.example .dev.vars; node scripts/ensure-worker-test-assets.mjs; vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test",
    "verify:local-routes": "node scripts/verify-local-routes.mjs",
    "verify:local-loop": "pnpm build && node scripts/verify-local-loop.mjs",
    "verify:local-mcp": "pnpm build && node scripts/verify-local-mcp-loop.mjs",
    "verify:plugin": "node scripts/verify-plugin-bundle.mjs && node scripts/verify-plugin-distribution.mjs",
    "verify:plugin:public": "node scripts/verify-plugin-distribution.mjs --remote",
    "verify:production": "node scripts/verify-production-smoke.mjs",
    "publish:plugin:public": "node scripts/publish-public-plugin.mjs",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run",
    "size": "size-limit",
    "verify:assets": "node scripts/verify-assets.mjs --skip-network",
    "verify:assets:network": "node scripts/verify-assets.mjs",
    "compress:assets": "node scripts/compress-assets.mjs",
    "size:assets": "node scripts/check-assets-chunk-size.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "^0.20.1",
    "jose": "^6.2.12",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "14.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "size-limit": "14.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "4.114.0",
    "@gltf-transform/cli": "4.2.1",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1"
  },
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  }
}
