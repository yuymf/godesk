{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": [
    "worker",
    "worker-configuration.d.ts",
    "src/creator/project-contract.ts",
    "src/creator/default-examples.ts",
    "src/creator/hobbyist-starters.ts",
    "src/public-mount.ts",
    "src/runtime/harbor-voyage.ts",
    "src/runtime/genre.ts",
    "src/runtime/playability-floor.ts",
    "src/runtime/hidden-role.ts",
    "src/runtime/hand-play.ts",
    "src/runtime/conversation-relay.ts"
  ]
}
