{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "godesk",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  // Repo carries placeholders only (public repo hygiene, 2026-10-29).
  // Production: .github/workflows/deploy.yml injects the real values as
  //   `wrangler deploy --var KEY:VALUE` from GitHub Actions secrets
  //   (GODESK_AUTH_ISSUER / GODESK_AUTH_AUDIENCE / GODESK_ACCESS_AUD), failing
  //   the job loudly if any is empty — placeholders never reach production.
  // Local dev: .dev.vars (gitignored) overrides these during `wrangler dev`.
  // See README "Deploy (Cloudflare)" for the full matrix.
  "vars": {
    "GODESK_AUTH_ISSUER": "https://godesk-placeholder.invalid/cdn-cgi/access/sso/oidc/REPLACE_ME",
    "GODESK_AUTH_AUDIENCE": "REPLACE_ME-VIA-DEPLOY",
    // GoDesk Creator and MCP Access application AUD tag (ZT Overview). App UUID is not the AUD.
    "GODESK_ACCESS_AUD": "REPLACE_ME-VIA-DEPLOY",
    // Local 3d-asset-server sidecar (Tidewell 资产搜索). Override with ASSET_SERVER_URL in .dev.vars.
    "ASSET_SERVER_URL": "http://127.0.0.1:8787"
  },
  "secrets": {
    "required": [
      "GODESK_SHARE_SECRET",
      "GODESK_WEB_CLIENT_ID",
      "GODESK_WEB_CLIENT_SECRET"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/try/*",
      "/mcp",
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/mcp",
      "/login",
      "/oauth/callback",
      "/chatgpt-plugin/api/*",
      "/chatgpt-plugin/try/*",
      "/chatgpt-plugin/mcp",
      "/chatgpt-plugin/login",
      "/chatgpt-plugin/oauth/callback",
      "/.well-known/oauth-protected-resource/chatgpt-plugin/mcp"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CREATOR_PROJECTS",
        "class_name": "CreatorProjects"
      }
    ]
  },
  "exports": {
    "CreatorProjects": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
