{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --enable-unsafe-swiftshader"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^http://127\\.0\\.0\\.1:[0-9]+/$",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 200, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        },
        {
          "matchingUrlPattern": "/room/",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.6, "aggregationMethod": "median-run" }],
            "total-blocking-time": ["error", { "maxNumericValue": 600, "aggregationMethod": "median-run" }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
