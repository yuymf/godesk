# Local-only placeholders. Production must set these with `wrangler secret put`.
GODESK_SHARE_SECRET=godesk-local-share-secret
GODESK_WEB_CLIENT_ID=godesk-local-web-client
GODESK_WEB_CLIENT_SECRET=godesk-local-web-client-secret

# ── Zero Trust identifiers (repo ships placeholders in wrangler.jsonc) ──
# These override the wrangler.jsonc placeholders during `wrangler dev`.
# Production CI injects the real values via `wrangler deploy --var` from
# GitHub Actions secrets (see .github/workflows/deploy.yml). Self-hosting
# under your own account: create the values below from your own Cloudflare
# Zero Trust dashboard.
#
# GODESK_AUTH_ISSUER=https://<your-team>.cloudflareaccess.com/cdn-cgi/access/sso/oidc/<oidc-app-aud>
# GODESK_AUTH_AUDIENCE=<same 64-hex aud as in the issuer URL>
# GODESK_ACCESS_AUD=<application AUD tag from Zero Trust > Access > Applications > Overview>
#
# Optional, only for manual `pnpm deploy` from this machine:
# CLOUDFLARE_ACCOUNT_ID=<32-hex account id>   (then: set -a; . .dev.vars; set +a; pnpm deploy)

# Optional: MCP Code Mode（渐进披露）。设为 1 时 listTools 仅 search+execute。默认不要开。
# GODESK_MCP_CODE_MODE=1

# Optional: 3d-asset-server sidecar for Creator 「资产搜索」(Tidewell).
# Default matches wrangler.jsonc: http://127.0.0.1:8787
# ASSET_SERVER_URL=http://127.0.0.1:8787
