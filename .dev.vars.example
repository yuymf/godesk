# Local-only placeholders. Production must set these with `wrangler secret put`.
GODESK_SHARE_SECRET=godesk-local-share-secret
GODESK_WEB_CLIENT_ID=godesk-local-web-client
GODESK_WEB_CLIENT_SECRET=godesk-local-web-client-secret

# For non-local Access JWT verification, copy the application's AUD tag from
# Zero Trust > Access > Applications. This is distinct from GODESK_AUTH_AUDIENCE.
# GODESK_ACCESS_AUD=<application-AUD-tag>

# Optional: MCP Code Mode（渐进披露）。设为 1 时 listTools 仅 search+execute。默认不要开。
# GODESK_MCP_CODE_MODE=1
